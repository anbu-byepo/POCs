# Razorpay test-mode keys (Dashboard -> Test Mode -> Account & Settings -> API Keys).
# Live keys (rzp_live_) are refused. Copy to .env for `pnpm serve`; on Netlify,
# set the same names under Site configuration -> Environment variables.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only needed to try the webhook endpoint (/api/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=
# Optional: Claude API key for the AI arrival call (console.anthropic.com).
# Without it the patient app plays a scripted call instead.
ANTHROPIC_API_KEY=
# Google Maps Routes API, server-side only (travel times with live traffic,
# distances, tolls, transit fares). Auth is OAuth through Application Default
# Credentials as development@ninto-dev-502310.iam.gserviceaccount.com, billed to
# the "Maps Provision" project (radiant-psyche-413003).
# Local dev, no key file: run once, then leave the vars below empty --
#   gcloud auth application-default login \
#     --impersonate-service-account=development@ninto-dev-502310.iam.gserviceaccount.com
# Or with a key file: GOOGLE_APPLICATION_CREDENTIALS = its path.
# Netlify (not on GCP, so no ADC): GOOGLE_SERVICE_ACCOUNT_JSON = the key JSON or base64.
# Never commit a key file. GOOGLE_CLOUD_PROJECT is the quota/billing project.
# GOOGLE_MAPS_API_KEY is an optional fallback. With nothing, the trip planner
# uses built-in estimates.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=radiant-psyche-413003
GOOGLE_MAPS_API_KEY=
# Arrival calls: real IVR phone calls on Exotel (keypad menu, no AI). Without
# these, IVR calls are simulated (reception enters the keypress). The IVR flow
# is built once in the Exotel dashboard; see ../netlify/functions/exotel.mjs.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# api.exotel.com (Singapore) or api.in.exotel.com (Mumbai)
EXOTEL_SUBDOMAIN=api.exotel.com
# Your ExoPhone (the number patients see) and the IVR flow's App ID
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=
# Random string; Exotel's callbacks to us must carry ?k=<it>
EXOTEL_WEBHOOK_SECRET=
# This site's public https URL for Exotel's end-of-call report (locally: ngrok)
EXOTEL_PUBLIC_URL=
# Comma-separated numbers calls may go to (the endpoint is public)
EXOTEL_ALLOWED_TO=
# Optional: ElevenLabs voice agent for the arrival call (ElevenLabs does the
# voice, Claude decides what to say). Create the agent once from Clinic app ->
# Settings -> Arrival calls -> "Create the agent" (or POST /api/elevenlabs/setup),
# then put its id in ELEVENLABS_AGENT_ID.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Agent LLM (an ElevenLabs llm id). Default claude-opus-5-5.
ELEVENLABS_LLM=
ELEVENLABS_VOICE_ID=
# Real phone calls: the number imported into ElevenLabs, and how it's connected.
# sip = SIP trunk from an Indian carrier (Plivo / Exotel), recommended for India;
# twilio = Twilio (can only call Indian mobiles from a non-Indian number).
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_PHONE_PROVIDER=sip
# Comma-separated numbers real calls may go to (the endpoint is public).
ELEVENLABS_ALLOWED_TO=
# Optional: verifies the post-call webhook (/api/elevenlabs/webhook).
ELEVENLABS_WEBHOOK_SECRET=
