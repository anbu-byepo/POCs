# Razorpay test-mode keys (Dashboard -> Test Mode -> Account & Settings -> API Keys).
# Live keys (rzp_live_) are refused. Copy to .env for `pnpm serve`; on Netlify,
# set the same names under Site configuration -> Environment variables.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only needed to try the webhook endpoint (/api/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=
